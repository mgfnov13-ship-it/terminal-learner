# Optional local Supabase overrides. Production builds already connect to the
# Terminal Academy project using its public browser key; Vercel env vars are not
# required. Leave blank to keep local development in browser-only mode.
#
# Use Project Settings -> API for a separate development project.
# This must be the public "anon" key. Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
