# Supabase project credentials. Both must be set for Terminal Space to connect
# accounts and cloud progress — leave them blank to keep running in local
# development mode (progress stays in this browser only, no sign-in required).
#
# Find these in your Supabase project: Project Settings -> API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key — never paste the
# service_role key here or anywhere else in this app's client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
